# HyperFrames project: keep the editable sources, not media, renders or caches
final_hf/assets/*.mp4
final_hf/assets/*.wav
final_hf/renders/
final_hf/snapshots/
final_hf/.hyperframes/
# A/B hook variants: keep sources, not media, mixes, review files or caches
ab_variants/*/assets/*.mp4
ab_variants/*/assets/*.wav
ab_variants/*/snapshots/
ab_variants/*/.hyperframes/
ab_variants/*/renders/
ab_variants/review/
